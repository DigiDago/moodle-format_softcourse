{{!
    @template format_softcourse/sections

    Block template for softcourse sections

    This template is used to generate a basic display for the softcourse sections list.

    Classes required for JS:
    * none

    Context variables required for this template:
    * initialsection object section
    * sections object of section
        * skip bool

    Example context (json):
    {
        "initialsection": {
            "id": 34,
            "num": 0,
            "skip": false,
            "first_cm_url": "#",
            "summary": {
                "summarytext": "General section"
            },
            "countactivitiestooltip": "Count of activities",
            "countactivities": 1
        },
        "sections": [
            {
                "id": 35,
                "num": 1,
                "skip": false,
                "name": "Section 1",
                "first_cm_url": "#",
                "summary": {
                    "summarytext": "Summary text!"
                },
                "countactivitiestooltip": "Count of activities",
                "countactivities": 2,
                "progression": "Progression",
                "progression_percent": 50
            }
        ]
    }
}}

<div id="softcourse-sections">
    <ul id="softcourse-tabs" role="tablist">
        {{$ initialsection }}
            {{#initialsection}}
                {{^skip}}
                <li role="tab" id="softcourse-section-{{ id }}" class="softcourse-section card position-relative">
                    {{> format_softcourse/section }}
                </li>
                {{/skip}}
            {{/initialsection}}
        {{/ initialsection}}
        {{$ sections }}
            {{# sections}}
                {{^skip}}
                <li role="tab" id="softcourse-section-{{ id }}" class="softcourse-section card position-relative">
                    {{> format_softcourse/section }}
                </li>
                {{/skip}}
            {{/sections}}
        {{/ sections}}
    </ul>
</div>
